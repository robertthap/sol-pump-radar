# Anchored to the repo root: an unanchored `data/` also matched source dirs like
# lib/chart/data/, silently excluding them from the repo (broke CI typecheck).
/data/
# Worker runtime traces (engine-b + intelligence JSONL). Reached 1.2 GB in 26
# days and is NOT covered by the anchored `/data/` above, so `git add -A` would
# stage it. Research data — keep on disk, never in the repo. See docs/operations.md.
apps/worker/data/
sessions/
coverage/
# Scratch output from one-off tooling run inside the repo root. Anchored, so a
# source dir named output/ elsewhere is still tracked. These reached the index
# once via `git add -A` and carried unrelated binaries into a branch.
/output/
/outputs/
# Generator for /outputs/risk_matrix; imports from a machine-local runtime cache
# and is unrelated to this app. Kept on disk, out of the repo.
/build_risk_matrix.mjs

