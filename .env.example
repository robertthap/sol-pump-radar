# sol-pump-radar configuration.
# Copy this file to .env.local. .env.local is gitignored — never commit secrets.

# ---------- Database ----------
# Docker Postgres. Start with: pnpm db:up && pnpm db:migrate
DATABASE_URL=postgresql://sol:sol@127.0.0.1:5432/solpump

# ---------- Solana RPC (free public endpoints; comma-separated, rotated) ----------
RPC_HTTP_URLS=https://api.mainnet-beta.solana.com
RPC_WSS_URLS=wss://api.mainnet-beta.solana.com

# Optional free-tier providers (signup required, still $0). Leave blank to skip.
# Helius free tier: https://helius.dev (100k req/day, ~10 req/s sustained).
HELIUS_API_KEY=
SHYFT_API_KEY=
JUPITER_API_KEY=

# ---------- Notifications ----------
DISCORD_WEBHOOK_URL=

# ---------- Runtime profile (hard gate on live execution) ----------
# paper_safe = no live transactions can ever fire from this process
# dev        = devnet only
# live       = mainnet allowed (requires LIVE_EXECUTION=on + LIVE_CONFIRM)
RUNTIME_PROFILE=paper_safe

# ---------- Trader mode ----------
# paper   = simulated executor only (default, safe)
# devnet  = real txs against Solana devnet, no real money
# live    = real txs against mainnet (gated behind paper success criteria)
TRADER_MODE=paper

# ---------- Risk preset ----------
# conservative | balanced | aggressive
RISK_PRESET=aggressive

# ---------- Signal mode ----------
# hybrid = launch analytics + Dex continuation (recommended)
# profit = continuation/trending focus
# launch = sniper/new-coin focus only
SIGNAL_MODE=hybrid
# ACTIVE_MINT_WINDOW_MINUTES=240

# ---------- Paper trading (single account, single portfolio) ----------
# Starting balance after reset. Realistic simulation enabled by default.
PAPER_START_SOL=10
PAPER_ENABLE_SLIPPAGE=on
PAPER_ENABLE_FEES=on
PAPER_ENABLE_LATENCY=on
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MAX_POSITION_SOL=0.25
PAPER_DAILY_LOSS_LIMIT_SOL=1
# How often the worker recomputes unrealized PnL (ms).
PAPER_MARK_TO_MARKET_MS=10000

# ---------- Auto-tuner ----------
AUTO_TUNE=off

# ---------- Wallet vault (encrypted local keypair) ----------
VAULT_PATH=./data/vault.bin

# ---------- Retention ----------
EVENT_RETENTION_DAYS=7

# ---------- Workers (runtime is apps/worker; Next must not start workers) ----------
# WORKERS=on tells the UI to expect an external `pnpm worker` process and to
# show worker-related diagnostics. Next itself never boots workers.
# Chart live candles require the worker (WebSocket on CHART_WS_PORT).
# CHART_WS_PORT=8788
# NEXT_PUBLIC_CHART_WS_URL=ws://127.0.0.1:8788/chart
WORKERS=on
AUTO_DEMO_RELAX=on

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Live execution (off by default; triple-gated) ----------
# 1. RUNTIME_PROFILE must be 'live'
# 2. LIVE_EXECUTION must be 'on'
# 3. LIVE_CONFIRM must equal "I_UNDERSTAND_REAL_MONEY" (literal string)
# Setting LIVE_DRY_RUN=on bypasses the confirmation token for simulation runs.
LIVE_EXECUTION=off
LIVE_DRY_RUN=on
LIVE_CONFIRM=
LIVE_MAX_PER_TRADE_SOL=0.1
LIVE_MAX_DAILY_SOL=0.5
LIVE_MAX_DAILY_LOSS_SOL=0.2
LIVE_MAX_CONSECUTIVE_LOSSES=3
LIVE_SLIPPAGE_BPS=500
LIVE_PRIORITY_FEE_SOL=0.0005

# ---------- Backpressure ----------
MAX_INGEST_QUEUE=5000
WORKER_HEARTBEAT_TIMEOUT_MS=60000

# ---------- Wallet ----------
WALLET_AUTO_LOCK_MINUTES=30
# Keep OFF for worker-owned signing architecture.
WEB_WALLET_SESSION=off
# Worker auto-unlocks local vault for queued live trades (never set in web-only processes).
# VAULT_PASSPHRASE=
# NEXT_PUBLIC_PHANTOM_APP_ID=
# NEXT_PUBLIC_USE_LOCAL_VAULT=1

# ---------- Trade routing ----------
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local

# ---------- Intelligence commit (single authority) ----------
INTELLIGENCE_TICK_MS=5000
INTELLIGENCE_UNIVERSE_MAX=80
INTELLIGENCE_SKIP_UNCHANGED_MS=45000
INTELLIGENCE_TOP_RANK=15
INTELLIGENCE_MAX_EVAL_PER_TICK=30
INTELLIGENCE_MAX_COMMITS_PER_TICK=8
INTELLIGENCE_BUNDLE_TTL_MS=15000
INTELLIGENCE_MAX_LAUNCH_HOT_PER_TICK=8
LAUNCH_HOT_MIN_V_SOL=2
LAUNCH_HOT_MIN_TRADES=1
LAUNCH_HOT_MIN_UNIQUE_WALLETS=2
LAUNCH_HOT_MIN_GATES=2
LAUNCH_HOT_MIN_SCORE=0.45
LAUNCH_HOT_TTL_MS=18000

# ---------- Engine B (continuation) ----------
AUTO_CONTINUATION=off
CONTINUATION_MIN_LIQ_USD=8000
CONTINUATION_RANK_EMIT_PCTL=0.7
CONTINUATION_P_EXHAUSTION_BLOCK=0.7
CONTINUATION_P_BREAKOUT_ALERT=0.65
CONTINUATION_P_BREAKOUT_BUY=0.8
